NODE_ENV=development
MAIL_PROVIDER=mock
DATABASE_PATH=.data/inboxguardian.sqlite
PORT=4317
# Gmail mode only. Desktop OAuth client; tokens remain in memory during normal use.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4318/oauth/callback
# Obtain with pnpm auth:gmail; store in your private environment, never in source.
GOOGLE_REFRESH_TOKEN=

# Alternative to GOOGLE_REFRESH_TOKEN, generated by pnpm auth:gmail:
GOOGLE_TOKEN_FILE=

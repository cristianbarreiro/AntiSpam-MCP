{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "esModuleInterop": true, "skipLibCheck": true,
    "jsx": "react-jsx", "lib": ["ES2023", "DOM"], "resolveJsonModule": true,
    "types": ["node"], "forceConsistentCasingInFileNames": true
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "apps/dashboard/dist"]
}
